# Salin file ini menjadi ".env" lalu isi nilainya.
# Cara termudah: pastikan sudah `neon login`, lalu jalankan `neon link`
# dari root project — kedua variabel di bawah terisi otomatis.
#
# DATABASE_URL          : koneksi POOLED (hostname mengandung "-pooler") untuk aplikasi/runtime.
# DATABASE_URL_UNPOOLED : koneksi DIRECT (tanpa "-pooler") untuk migrasi skema (prisma migrate).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
